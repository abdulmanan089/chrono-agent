{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -m chrono_agent guard hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
